# ===================================================
# Padlet 荒らし対策Bot 設定ファイル (.env)
# 【完全内部API対応・有料APIキー不要】
# ===================================================

# 1. Padlet Web Session Token 1 (メイン管理アカウントのBearerトークン) 【必須】
#    内部API通信（投稿取得・作成、セクション復元、荒らし削除、読者固定等）に使用されます。
PADLET_SESSION_TOKEN=your_main_account_session_bearer_token_here

# 2. Padlet Web Session Token 2 (サブ管理アカウントのBearerトークン - レート制限分散用) 【推奨】
#    2つのアカウントで交互にリクエストを分散し、20人同時荒らし・DDoS時の429制限を回避します。
PADLET_SECONDARY_TOKEN=your_secondary_account_session_bearer_token_here

# 3. Discord 通知用 Webhook URL 【任意】
#    指定されている場合は、@everyone メンション付きでリアルタイム通知します。
#    ※ 空欄（未指定）の場合は、Padletボード内の指定通知セクションに自動で通知投稿が作成されます！
DISCORD_WEBHOOK_URL=

# 4. 管理パネルのログインパスワード (環境変数で設定！他の人と被らない安全な文字列を指定) 【推奨】
ADMIN_PASSWORD=your_secure_admin_password_here

# 5. セッション暗号化キー (任意: 未設定でも起動時に安全な個別ランダム値が自動生成されます)
# SECRET_KEY=your_random_secret_key_here

# 6. サーバー起動ポート (Local: 8080 / Railway: 自動設定)
PORT=8080
