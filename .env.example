# ===================================================
# Padlet 荒らし対策Bot 設定ファイル (.env)
# ===================================================

# 1. Padlet 公式 API Key (Developer画面で発行)
#    ボード情報の取得や投稿作成などの公式REST APIに使用されます。
PADLET_API_KEY=your_padlet_api_key_here

# 2. Padlet Web Session Token 1 (メイン管理アカウントのBearerトークン)
#    荒らし投稿の完全削除(DELETE)、セクション削除、読者への降格(PATCH)に使用されます。
PADLET_SESSION_TOKEN=your_main_account_session_bearer_token_here

# 3. Padlet Web Session Token 2 (サブ管理アカウントのBearerトークン - レート制限分散用)
#    2つのアカウントでリクエストを交互に分散し、大量荒らし(DDoS)時のレート制限(429)を回避します。
PADLET_SECONDARY_TOKEN=your_secondary_account_session_bearer_token_here

# 4. Discord 通知用 Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here

# 5. 管理パネルのログインパスワード (環境変数で設定！他の人と被らない安全な文字列を指定)
ADMIN_PASSWORD=your_secure_admin_password_here

# 6. セッション暗号化キー (任意: 未設定でも起動時に安全な個別ランダム値が自動生成されます)
# SECRET_KEY=your_random_secret_key_here

# 7. サーバー起動ポート (Local: 8080 / Railway: 自動設定)
PORT=8080
